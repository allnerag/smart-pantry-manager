<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="20dp"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_pantry_header"
        android:padding="24dp"
        android:text="@string/recipe_collection"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/collection_help"
        android:textSize="16sp"
        android:textColor="@color/pantry_text_secondary" />
    <TextView
        android:id="@+id/textCollectionCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:accessibilityLiveRegion="polite"
        android:textSize="16sp"
        android:textColor="@color/richfield_navy" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAddRecipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_recipe" />
</LinearLayout>