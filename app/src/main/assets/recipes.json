            },
            {
              "ingredientId": "onion",
              "quantity": 150,
              "unit": "g"
            },
            {
              "ingredientId": "bread",
              "quantity": 60,
              "unit": "g"
            },
            {
              "ingredientId": "milk",
              "quantity": 250,
              "unit": "ml"
            },
            {
              "ingredientId": "egg",
              "quantity": 2,
              "unit": "count"
            },
            {
              "ingredientId": "oil",
              "quantity": 15,
              "unit": "ml"
            },
            {
              "ingredientId": "curry_powder",
              "quantity": 10,
              "unit": "g"
            },
            {
              "ingredientId": "chutney",
              "quantity": 40,
              "unit": "g"
            },
            {
              "ingredientId": "raisin",
              "quantity": 40,
              "unit": "g"
            },
            {
              "ingredientId": "salt",
              "quantity": 4,
              "unit": "g"
            }
          ],
          "steps": [
            "Heat the oven to 180°C. Chop the onion and soften it in the oil in a frying pan.",
            "Add the mince and cook, breaking it up. Stir in the curry powder and salt.",
            "Soak the bread in 100 ml of the milk. Mash it and stir it into the mince with the chutney and raisins. Cook for five minutes, then transfer to a baking dish.",
            "Beat the eggs with the remaining 150 ml milk. Pour over the mince and bake for about 35 minutes until the topping is set and the centre is piping hot."
          ]
        }
      ]
    },
    {
      "id": "tomato_bredie",
      "title": "Tomato bredie",
      "variants": [
        {
          "id": "bredie_default",
          "label": "Standard",
          "yield": "4 servings",
          "ingredients": [
            {
              "ingredientId": "lamb",
              "quantity": 600,
              "unit": "g"
            },
            {
              "ingredientId": "tomato",
              "quantity": 600,
              "unit": "g"
            },
            {
              "ingredientId": "onion",
              "quantity": 150,
              "unit": "g"
            },
            {
              "ingredientId": "potato",
              "quantity": 400,
              "unit": "g"
            },
            {
              "ingredientId": "oil",
              "quantity": 20,
              "unit": "ml"
            },
            {
              "ingredientId": "water",
              "quantity": 400,
              "unit": "ml"
            },
            {
              "ingredientId": "salt",
              "quantity": 5,
              "unit": "g"
            },
            {
              "ingredientId": "black_pepper",
              "quantity": 1,
              "unit": "g"
            }
          ],
          "steps": [
            "Cut the lamb into chunks, chop the onion and tomatoes, and peel and cube the potatoes.",
            "Heat the oil in a heavy pot. Brown the lamb in batches, then soften the onion in the same pot.",
            "Return all the lamb to the pot. Add the tomatoes, water, salt and pepper. Cover and simmer gently for 60 minutes.",
            "Add the potatoes. Cover and simmer for another 30–45 minutes until the lamb and potatoes are tender, stirring occasionally."
          ]
        }
      ]
    },
    {
      "id": "beef_potjie",
      "title": "Beef potjiekos",
      "variants": [
        {
          "id": "potjie_default",
          "label": "Standard",
          "yield": "4 servings",
          "ingredients": [
