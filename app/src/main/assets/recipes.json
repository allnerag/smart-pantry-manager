  "recipes": [
    {
      "id": "pap_wors",
      "title": "Pap and wors",
      "variants": [
        {
          "id": "pap_raw",
          "label": "Make pap from maize meal",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "maize_meal",
              "quantity": 200,
              "unit": "g"
            },
            {
              "ingredientId": "water",
              "quantity": 800,
              "unit": "ml"
            },
            {
              "ingredientId": "salt",
              "quantity": 2,
              "unit": "g"
            },
            {
              "ingredientId": "boerewors",
              "quantity": 300,
              "unit": "g"
            }
          ],
          "steps": [
            "Bring the water and salt to a boil in a heavy saucepan. Gradually stir in the maize meal.",
            "Reduce to low heat, cover and cook for about 30 minutes, stirring regularly, until the pap is cooked and thick.",
            "Grill the boerewors over moderate heat, turning regularly, until cooked through. Serve with the pap."
          ]
        },
        {
          "id": "pap_prepared",
          "label": "Use cooked pap",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "cooked_pap",
              "quantity": 500,
              "unit": "g"
            },
            {
              "ingredientId": "water",
              "quantity": 50,
              "unit": "ml"
            },
            {
              "ingredientId": "boerewors",
              "quantity": 300,
              "unit": "g"
            }
          ],
          "steps": [
            "Break the cooked pap into a saucepan and add the water. Cover and warm gently, stirring, until steaming throughout.",
            "Grill the boerewors over moderate heat, turning regularly, until cooked through. Serve with the reheated pap."
          ]
        }
      ]
    },
    {
      "id": "mash_wors",
      "title": "Mash and wors",
      "variants": [
        {
          "id": "mash_raw",
          "label": "Make mash from potatoes",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "potato",
              "quantity": 500,
              "unit": "g"
            },
            {
              "ingredientId": "water",
              "quantity": 1500,
              "unit": "ml"
            },
            {
              "ingredientId": "milk",
              "quantity": 100,
              "unit": "ml"
            },
            {
              "ingredientId": "butter",
              "quantity": 20,
              "unit": "g"
            },
            {
              "ingredientId": "salt",
              "quantity": 2,
              "unit": "g"
            },
            {
              "ingredientId": "boerewors",
              "quantity": 300,
              "unit": "g"
            }
          ],
          "steps": [
            "Peel and dice the potatoes. Put in a saucepan with the water and bring to a boil. Simmer for 15–20 minutes until tender.",
            "Drain the potatoes. Warm the milk and mash it into the potatoes with the butter and salt.",
            "Grill the boerewors over moderate heat, turning regularly, until cooked through. Serve with the mash."
          ]
        },
        {
          "id": "mash_prepared",
          "label": "Use prepared mash",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "prepared_mash",
              "quantity": 500,
              "unit": "g"
            },
            {
              "ingredientId": "boerewors",
              "quantity": 300,
              "unit": "g"
            }
          ],
          "steps": [
            "Reheat the prepared mash in a covered microwave-safe dish, stirring at intervals, until steaming throughout.",
            "Grill the boerewors over moderate heat, turning regularly, until cooked through. Serve with the reheated mash."
          ]
        }
      ]
    },
    {
      "id": "vienna_hotdogs",
      "title": "Vienna hot dogs",
      "variants": [
        {
          "id": "vienna_default",
          "label": "Standard",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "vienna",
              "quantity": 4,
              "unit": "count"
            },
            {
              "ingredientId": "long_bun",
              "quantity": 4,
              "unit": "count"
            },
            {
              "ingredientId": "water",
              "quantity": 1000,
              "unit": "ml"
            }
          ],
          "steps": [
            "Heat the water in a saucepan. Heat the Viennas in it according to their package instructions until steaming hot.",
            "Drain the Viennas, split the buns and put one Vienna in each bun. Serve two per person."
          ]
        }
      ]
    },
    {
      "id": "boerie_rolls",
      "title": "Boerewors rolls",
      "variants": [
        {
          "id": "boerie_default",
          "label": "Standard",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "boerewors",
              "quantity": 300,
              "unit": "g"
            },
            {
              "ingredientId": "long_bun",
              "quantity": 4,
              "unit": "count"
            }
          ],
          "steps": [
            "Grill the boerewors over moderate heat, turning regularly, until cooked through.",
            "Split the buns. Cut the cooked boerewors into four portions and put one portion in each bun."
          ]
        }
      ]
    },
    {
      "id": "bully_eggs",
      "title": "Bully beef and eggs",
      "variants": [
        {
          "id": "bully_eggs_default",
          "label": "Standard",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "corned_beef",
              "quantity": 300,
              "unit": "g"
            },
            {
              "ingredientId": "egg",
              "quantity": 4,
              "unit": "count"
            },
            {
              "ingredientId": "oil",
              "quantity": 10,
              "unit": "ml"
            }
          ],
          "steps": [
            "Break up the bully beef. Warm the oil in a frying pan and heat the beef until steaming hot.",
            "Beat the eggs, pour them into the pan and stir gently until the eggs are fully set. Serve immediately."
          ]
        }
      ]
    },
    {
      "id": "creamy_pasta",
      "title": "Creamy cheese pasta with white sauce",
      "variants": [
        {
          "id": "creamy_pasta_default",
          "label": "Standard",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "pasta",
              "quantity": 200,
              "unit": "g"
            },
            {
              "ingredientId": "water",
              "quantity": 2000,
              "unit": "ml"
            },
            {
              "ingredientId": "white_sauce",
              "quantity": 250,
              "unit": "ml"
            },
            {
              "ingredientId": "cheese",
              "quantity": 100,
              "unit": "g"
            }
          ],
          "steps": [
            "Boil the pasta in the water for the time on its packet, then drain.",
            "Heat the prepared white sauce gently in the saucepan. Grate the cheese and stir it into the sauce until melted.",
            "Add the drained pasta and stir over low heat until hot throughout."
          ]
        }
      ]
    },
    {
      "id": "bully_cheese_pasta",
      "title": "Bully beef and cheese pasta",
      "variants": [
        {
          "id": "bully_pasta_default",
          "label": "Standard",
          "yield": "2 servings",
          "ingredients": [
            {
              "ingredientId": "corned_beef",
              "quantity": 300,
              "unit": "g"
            },
            {
              "ingredientId": "pasta",
              "quantity": 200,
              "unit": "g"
            },
            {
              "ingredientId": "water",
              "quantity": 2000,
              "unit": "ml"
            },
            {
              "ingredientId": "cheese",
              "quantity": 100,
              "unit": "g"
            }
          ],
          "steps": [
            "Boil the pasta in the water following the packet timing. Reserve 50 ml of the cooking water before draining.",
            "Break up the bully beef in the saucepan. Add the reserved water and heat until steaming.",
            "Stir in the pasta and grated cheese. Heat gently until the cheese melts."
          ]
        }
      ]
    },
    {
      "id": "sweet_muffins",
      "title": "Plain sweet muffins",
      "variants": [
        {
          "id": "sweet_muffins_default",
          "label": "Standard",
          "yield": "12 muffins",
          "ingredients": [
            {
              "ingredientId": "flour",
              "quantity": 250,
              "unit": "g"
            },
            {
              "ingredientId": "sugar",
              "quantity": 120,
              "unit": "g"
            },
            {
              "ingredientId": "baking_powder",
              "quantity": 10,
              "unit": "g"
            },
            {
              "ingredientId": "salt",
              "quantity": 2,
              "unit": "g"
            },
            {
              "ingredientId": "egg",
              "quantity": 2,
              "unit": "count"
            },
            {
              "ingredientId": "milk",
              "quantity": 200,
              "unit": "ml"
            },
            {
              "ingredientId": "oil",
              "quantity": 80,
              "unit": "ml"
            }
          ],
          "steps": [
            "Heat the oven to 180°C and line a 12-hole muffin tin with paper cases.",
            "Mix the flour, sugar, baking powder and salt in one bowl. Beat the eggs, milk and oil in another.",
            "Fold the wet mixture into the dry ingredients just until no dry flour remains. Divide between the cases.",
            "Bake for 20–25 minutes until risen and a skewer inserted in the centre comes out clean. Cool on a rack."
          ]
        }
      ]
    },
    {
      "id": "savoury_muffins",
      "title": "Cheese savoury muffins",
      "variants": [
        {
          "id": "savoury_muffins_default",
          "label": "Standard",
          "yield": "12 muffins",
          "ingredients": [
            {
              "ingredientId": "flour",
              "quantity": 250,
              "unit": "g"
            },
            {
              "ingredientId": "cheese",
              "quantity": 150,
              "unit": "g"
            },
            {
              "ingredientId": "baking_powder",
              "quantity": 10,
              "unit": "g"
            },
            {
              "ingredientId": "salt",
              "quantity": 2,
              "unit": "g"
            },
            {
              "ingredientId": "egg",
              "quantity": 2,
              "unit": "count"
            },
            {
              "ingredientId": "milk",
              "quantity": 200,
              "unit": "ml"
            },
            {
              "ingredientId": "oil",
              "quantity": 60,
              "unit": "ml"
            }
          ],
          "steps": [
            "Heat the oven to 180°C and line a 12-hole muffin tin with paper cases.",
            "Mix the flour, baking powder, salt and grated cheese. In another bowl beat the eggs, milk and oil.",
            "Fold the wet mixture into the dry ingredients just until combined. Divide between the cases.",
            "Bake for 20–25 minutes until golden and a skewer comes out clean. Cool before serving."
          ]
        }
      ]
    },
    {
      "id": "frikkadels",
      "title": "Frikkadels",
      "variants": [
        {
          "id": "frikkadels_default",
          "label": "Standard",
          "yield": "4 servings",
          "ingredients": [
            {
              "ingredientId": "beef_mince",
              "quantity": 500,
              "unit": "g"
            },
            {
              "ingredientId": "onion",
              "quantity": 100,
              "unit": "g"
            },
            {
              "ingredientId": "bread",
              "quantity": 60,
              "unit": "g"
            },
            {
              "ingredientId": "milk",
              "quantity": 60,
              "unit": "ml"
            },
            {
              "ingredientId": "egg",
              "quantity": 1,
              "unit": "count"
            },
            {
              "ingredientId": "salt",
              "quantity": 4,
              "unit": "g"
            },
            {
              "ingredientId": "black_pepper",
              "quantity": 1,
              "unit": "g"
            },
            {
              "ingredientId": "oil",
              "quantity": 20,
              "unit": "ml"
            }
          ],
          "steps": [
            "Finely chop the onion. Soak the bread in the milk and mash with a fork.",
            "Mix the mince, onion, soaked bread, egg, salt and pepper. Shape into eight evenly sized meatballs.",
            "Heat the oil in a large frying pan. Brown the meatballs on all sides, then reduce the heat and cover.",
            "Cook gently, turning, until the centres are fully cooked. Serve the meatballs on their own."
          ]
        }
      ]
    },
    {
      "id": "bobotie",
      "title": "Bobotie",
      "variants": [
        {
          "id": "bobotie_default",
          "label": "Standard",
          "yield": "4 servings",
          "ingredients": [
            {
              "ingredientId": "beef_mince",
              "quantity": 500,
